generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// 공공데이터 원본 및 정규화된 신고 데이터 저장 (declarations)
model declarations {
  id                 Int      @id @default(autoincrement())
  prdlstReportNo     String   @unique // 품목제조번호 (PRDLST_REPORT_NO)
  bsshNm             String?  // 업소명 (BSSH_NM)
  prdlstNm           String?  // 품목명 (PRDLST_NM)
  dispos             String?  // 제품형태 (DISPOS) 또는 PRDT_SHAP_CD_NM
  prmsDt             String?  // 허가일자 (PRMS_DT)
  primaryFnclty      String?  // 주된기능성 (PRIMARY_FNCLTY)
  ntkMthd            String?  // 섭취방법 (NTK_MTHD)
  iftknAtntMatrCn    String?  // 섭취시주의사항 (IFTKN_ATNT_MATR_CN)
  cstdyMthd          String?  // 보관방법 (CSTDY_MTHD)
  rawmtrlNm          String?  // 품목유형(기능지표성분) (RAWMTRL_NM)
  
  // RAW API 추가 필드
  lcnsNo             String?  // 인허가번호 (LCNS_NO)
  pogDaycnt          String?  // 소비기한_일수 (POG_DAYCNT)
  prdlstCdnm         String?  // 유형 (PRDLST_CDNM)
  stdrStnd           String?  // 기준규격 (STDR_STND)
  hiengLntrtDvsNm    String?  // 고열량저영양여부 (HIENG_LNTRT_DVS_NM)
  production         String?  // 생산종료여부 (PRODUCTION)
  childCrtfcYn       String?  // 어린이기호식품품질인증여부 (CHILD_CRTFC_YN)
  prdtShapCdNm       String?  // 제품_형태_코드_명 (PRDT_SHAP_CD_NM)
  frmlcMtrqlt        String?  // 포장재질 (FRMLC_MTRQLT)
  indutyCdNm         String?  // 업종 (INDUTY_CD_NM)
  lastUpdtDtm        String?  // 최종수정일자 (LAST_UPDT_DTM)
  indvRawmtrlNm      String?  // 기능성 원재료 (INDV_RAWMTRL_NM)
  etcRawmtrlNm       String?  // 기타 원재료 (ETC_RAWMTRL_NM)
  capRawmtrlNm       String?  // 캡슐 원재료 (CAP_RAWMTRL_NM)
  frmlcMthd          String?  // 포장방법 (FRMLC_MTHD)
  
  // 기능적 요구사항 (정규화된 데이터)
  normalizedPackaging     String?  // 정규화된 포장재질
  normalizedFunctionality String?  // 정규화된 기능성
  searchFunctionality     String?  // 검색용 기능성 (공백/대소문자 무시용)
  normalizedRawMaterials  String?  // 정규화된 원재료
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// 사전 매핑 테이블 / 정규화 룰 (normalization_rules)
model normalization_rules {
  id                 Int      @id @default(autoincrement())
  ruleType           String   // 'PACKAGING', 'FUNCTIONALITY', 'MATERIAL'
  originalText       String   // 원본 매칭 단어
  normalizedText     String   // 정규화 목표 단어
  createdAt          DateTime @default(now())
  
  @@unique([ruleType, originalText])
}

// 데이터 변경 이력 저장 (change_log)
model change_log {
  id             Int      @id @default(autoincrement())
  prdlstReportNo String
  type           String   // 'NEW', 'UPDATED', 'DELETED'
  changes        String?  // JSON string: 변경 내역
  loggedAt       DateTime @default(now())
}

// 동기화 일시 및 상태 저장 (sync_history)
model sync_history {
  id           Int      @id @default(autoincrement())
  status       String   // "SUCCESS" or "ERROR"
  addedCount   Int      @default(0)
  updatedCount Int      @default(0)
  deletedCount Int      @default(0)
  errorMessage String?
  executedAt   DateTime @default(now())
}

// 사용자 정의 배너/외부 링크 관리 (banners)
model banners {
  id        Int      @id @default(autoincrement())
  title     String
  imageUrl  String
  linkUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// 실시간 식품안전 알림 정보 저장 (food_alerts)
model food_alerts {
  id             Int      @id @default(autoincrement())
  type           String   // 'RECALL', 'INSPECTION', 'OVERSEAS_RECALL'
  uniqueKey      String   @unique // 중복 방지용 고유 식별값
  prdtNm         String?  // 제품명
  bsshNm         String?  // 업체명
  reason         String?  // 사유 (회수사유, 부적합항목, 위해성분 등)
  result         String?  // 판정결과 등
  regDate        String?  // 등록일/제조일
  imgUrl         String?  // 이미지 경로 (주로 회수정보)
  detailJson     String?  // 기타 상세 필드 전체 (JSON string)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type])
  @@index([regDate])
}

// API 동기화 상태 저장 (sync_state)
model sync_state {
  id             String   @id // API 서비스 ID (예: 'I0490')
  lastIndex      Int      @default(0)
  updatedAt      DateTime @updatedAt
}

// 건강기능식품 생산실적 보고 데이터 저장 (production_stats)
model production_stats {
  id                    Int      @id @default(autoincrement())
  prdlstReportNo        String   // 품목제조보고번호 (PRDLST_REPORT_NO)
  evlYr                 String   // 보고년도 (EVL_YR)
  bsshNm                String?  // 업소명 (BSSH_NM)
  prdlstNm              String?  // 품목명 (PRDLST_NM)
  hItemNm               String?  // 품목유형 (H_ITEM_NM)
  lcnsNo                String?  // 인허가번호 (LCNS_NO)
  gubun                 String?  // 품목구분 (GUBUN)
  fyerPrdctnAbrtQy      Float?   // 연간생산능력(KG) (FYER_PRDCTN_ABRT_QY)
  prdctnQy              Float?   // 생산량(KG) (PRDCTN_QY)
  createdAt             DateTime @default(now())

  @@unique([prdlstReportNo, evlYr])
  @@index([bsshNm])
  @@index([prdlstNm])
  @@index([evlYr])
  @@index([evlYr, prdctnQy(sort: Desc)])
  @@index([evlYr, bsshNm])
  @@index([evlYr, hItemNm])
}

// Q&A 문의 게시판 (qna_post)
model qna_post {
  id            Int       @id @default(autoincrement())
  title         String    // 문의 제목
  content       String    // 문의 내용
  category      String    @default("일반문의") // 일반문의, 데이터수정요청, 시스템오류, 기타
  authorName    String    // 작성자 이름
  authorCompany String?   // 회사명
  authorId      Int?      // 회원 ID (로그인 사용자)
  isSecret      Boolean   @default(false) // 비밀글 여부
  password      String?   // 비밀글/비회원 비밀번호
  answer        String?   // 관리자 답변 내용
  answeredAt    DateTime? // 답변 일시
  answeredBy    String?   // 답변자 이름
  isAnswered    Boolean   @default(false) // 답변 완료 여부
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([createdAt])
  @@index([isAnswered])
  @@index([category])
}

// 기능성 평가 가이드라인 게시판 (functional_guidelines)
model functional_guidelines {
  id             Int       @id @default(autoincrement())
  no             String?   // 게시글 번호
  title          String    // 제목
  dept           String?   // 작성부서
  regDate        String?   // 등록일
  viewCnt        String?   // 조회수
  content        String?   // 본문 내용
  attachmentName String?   // 첨부파일명
  attachmentUrl  String?   // 첨부파일 다운로드 URL
  localPdfPath   String?   // 로컬 저장 PDF 상대 경로
  detailUrl      String?   // 원문 상세 URL
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([title])
  @@index([regDate])
}

// 식품안전나라 개별인정원료 정보 공시 게시판 (raw_material_posts)
model raw_material_posts {
  id                Int       @id @default(autoincrement())
  no                Int?      // 게시글 번호 (no, 숫자)
  ntctxtNo          String?   @unique @map("ntctxt_no") // 글 고유번호 (ntctxt_no)
  title             String    // 제목 (titl)
  companyNm         String?   @map("company_nm") // 업체명
  recogNo           String?   @map("recog_no") // 인정번호
  functionalityText String?   @map("functionality_text") @db.Text // 기능성내용
  dailyIntake       String?   @map("daily_intake") @db.Text // 일일섭취량
  precautions       String?   @db.Text // 섭취시 주의사항
  regDate           String?   @map("reg_date") // 등록일
  viewCnt           String?   @map("view_cnt") // 조회수
  content           String?   @db.Text // 본문 상세 내용
  attachmentName    String?   @map("attachment_name") // 첨부파일명
  filePath          String?   @map("file_path") // 첨부파일 경로
  fileName          String?   @map("file_name") // 서버 물리파일명
  orgFileName       String?   @map("org_file_name") // 원본 논리파일명
  fileTypeCd        String?   @map("file_type_cd") // 파일타입
  ecmFileNo         String?   @map("ecm_file_no") // 파일 고유키
  localPdfPath      String?   @map("local_pdf_path") // 로컬 저장 경로
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([no])
  @@index([title])
  @@index([companyNm])
  @@index([recogNo])
  @@index([regDate])
}

// 사용자 관리 테이블
model user {
  id             Int      @id @default(autoincrement())
  username       String   @unique // 아이디
  password       String   // pbkdf2로 해싱된 비밀번호
  name           String   // 성명
  companyNm      String   // 회사명
  deptNm         String   // 부서명
  positionNm     String   // 직급
  titleNm        String   // 직책
  role           String   @default("USER") // ADMIN or USER or SALES
  isApproved     Boolean  @default(false) // 가입 승인 여부
  dailyChatLimit Int      @default(20)    // 일일 AI 질문 한도 (관리자는 무제한, 기본 20회)
  dailyChatCount Int      @default(0)     // 오늘 질문 사용 횟수
  lastChatDate   String?                  // 마지막 질문 일자 (YYYY-MM-DD)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// 작업 이력 로그 테이블
model audit_log {
  id        Int      @id @default(autoincrement())
  username  String   // 행동한 사용자 아이디
  role      String   // 사용자 권한
  page      String   // 작업 발생 페이지
  action    String   // 구체적인 행동
  details   String?  // 상세 변경 내용
  ipAddress String?  // 요청자 IP
  createdAt DateTime @default(now())
}

// 시스템 공지사항 팝업
model notice {
  id        Int       @id @default(autoincrement())
  title     String    // 공지 제목
  content   String    // 공지 내용
  isActive  Boolean   @default(true)
  startAt   DateTime? // 표시 시작일 (null = 즉시)
  endAt     DateTime? // 표시 종료일 (null = 무기한)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy Int       // 작성자 user.id
}

// 개별인정형원료
model individual_raw_materials {
  id                 Int      @id @default(autoincrement())
  recognitionNumber  String   @unique @map("recognition_number") // 인정번호 (예: 제2023-12호)
  name               String?  // 원료명
  company            String?  // 업체명
  functionalityText  String?  @map("functionality_text") // 기능성내용
  dailyIntake        String?  @map("daily_intake") // 일일섭취량
  precautions        String?  // 섭취시 주의사항
  registeredDate     String?  @map("registered_date") // 인정일자 또는 등록년도 (예: 2023 또는 2023.5.8.)
  detailContent      String?  @map("detail_content") // 상세내용
  categories         String?  // 매핑된 기능성 카테고리 목록 (쉼표 구분)
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// 일반식품 (식품(첨가물)품목제조보고) 데이터 저장
model general_declarations {
  id                    Int      @id @default(autoincrement())
  prdlstReportNo        String   @unique // 품목제조번호 (PRDLST_REPORT_NO)
  prmsDt                String?  // 허가일자 (PRMS_DT)
  lastUpdtDtm           String?  // 최종수정일자 (LAST_UPDT_DTM)
  lcnsNo                String?  // 인허가번호 (LCNS_NO)
  prdlstNm              String?  // 제품명 (PRDLST_NM)
  qltyMntncTmlmtDaycnt  String?  // 품질유지기한일수 (QLTY_MNTNC_TMLMT_DAYCNT)
  bsshNm                String?  // 업소명 (BSSH_NM)
  prdlstDcnm            String?  // 품목유형명 (PRDLST_DCNM)
  childCrtfcYn          String?  // 어린이기호식품품질인증여부 (CHILD_CRTFC_YN)
  indutyCdNm            String?  // 업종 (INDUTY_CD_NM)
  dispos                String?  // 제품형태 (DISPOS)
  frmlcMtrqlt           String?  // 포장재질 (FRMLC_MTRQLT)
  usage                 String?  // 용법 (USAGE)
  etqtyXportPrdlstYn    String?  // 내수/겸용구분 (ETQTY_XPORT_PRDLST_YN)
  pogDaycnt             String?  // 소비기한 (POG_DAYCNT)
  hiengLntrtDvsNm       String?  // 고열량저영양식품여부 (HIENG_LNTRT_DVS_NM)
  production            String?  // 생산종료여부 (PRODUCTION)
  prpos                 String?  // 용도 (PRPOS)

  // 정규화된 포장재질
  normalizedPackaging   String?  // 정규화된 포장재질

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([prdlstNm])
  @@index([bsshNm])
  @@index([prmsDt])
  @@index([prdlstDcnm])
  @@index([normalizedPackaging])
  @@index([dispos])
  @@index([prdlstReportNo])
}

// ── 건강기능식품심의위원회 회의록 & 안건 ───────────────────────────────────────
model committee_meetings {
  id           Int                 @id @default(autoincrement())
  seq          String              @unique // 식약처 게시글 고유번호 seq (예: 33423)
  postNo       String?             // 게시판 번호 (예: 359, 358)
  title        String              // 회의 제목 (예: 제202차 건강기능식품심의위원회 회의 결과)
  meetingNo    String?             // 회차 (예: 제202차)
  meetingDate  String?             // 일시 (예: 2026.4.30.(목))
  department   String?             // 담당부서 (예: 영양기능연구과)
  viewCount    Int?                // 조회수 (예: 2121)
  postDate     String?             // 등록일 (예: 2026-07-07)
  attendees    String?             // 참석자 정보 (예: 재적위원 28명 중 15명 참석)
  rawContent   String?             // 본문 원문 텍스트
  sourceUrl    String?             // 식약처 원본 링크
  pdfFileName  String?             // 첨부 PDF 파일명
  pdfFileUrl   String?             // 첨부 PDF 다운로드 링크
  hwpFileName  String?             // 첨부 HWP/HWPX 파일명
  hwpFileUrl   String?             // 첨부 HWP/HWPX 다운로드 링크
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  agendas      committee_agendas[]
}

model committee_agendas {
  id           Int                @id @default(autoincrement())
  meetingId    Int
  meeting      committee_meetings @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  orderIndex   Int                @default(1) // 안건 순번
  rawName      String             // 안건 원문 (예: 하고초추출분말 : 인정)
  ingredientName String           // 원료/성분명 (예: 하고초추출분말, 피치세라마이드(PF3) 등)
  result       String             // 심의 결과: "인정" | "보완" | "불인정" | "기타"
  agendaType   String?            // 신청 구분: "신규인정" | "기능성추가" | "기준규격" 등
  details      String?            // 안건 세부 내용 및 비고
  
  // RAG용 768차원 Gemini Embedding 벡터 (JSON string 저장)
  embedding    String?            // JSON.stringify(number[])

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([ingredientName])
  @@index([result])
}
